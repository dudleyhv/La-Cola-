---
// Widget de notificaciones flotantes tipo "Sole Retriever": una tarjeta que va
// cambiando sola cada pocos segundos (marcas nuevas y lanzamientos, en bucle),
// con un pequeño efecto de "pila" detrás, y que al pasar el cursor por encima
// se despliega mostrando el historial de lo que ha ido apareciendo.
//
// Uso: import NotificacionFlotante from '../components/NotificacionFlotante.astro';
//      <NotificacionFlotante marcas={marcas} drops={drops} />

interface Marca {
  slug: string;
  name: string;
  description: string;
  image: string | null;
  firstFeatured: string;
}

interface Drop {
  slug?: string;
  model: string;
  image: string | null;
  url?: string;
  date?: string;
  day?: string;
}

const { marcas = [], drops = [] } = Astro.props as { marcas: Marca[]; drops: Drop[] };

const marcasOrdenadas = [...marcas]
  .sort((a, b) => new Date(b.firstFeatured).getTime() - new Date(a.firstFeatured).getTime())
  .slice(0, 6)
  .map((m) => ({
    id: `marca-${m.slug}`,
    etiqueta: '🆕 Marca a seguir',
    titulo: m.name,
    subtitulo: m.description.length > 70 ? m.description.slice(0, 70) + '…' : m.description,
    imagen: m.image,
    enlace: `/marcas/${m.slug}`,
  }));

const dropsOrdenados = drops.slice(0, 8).map((d) => ({
  id: `drop-${d.slug || d.model}`,
  etiqueta: '🔥 Nuevo lanzamiento',
  titulo: d.model,
  subtitulo: d.date ? `Disponible: ${d.day ? d.day + ' ' : ''}${d.date}` : 'Disponible próximamente',
  imagen: d.image,
  enlace: d.slug ? `/noticias/${d.slug}` : (d.url || '/'),
}));

// Intercalamos marca / lanzamiento / marca / lanzamiento... para que no salgan
// todas las marcas seguidas y luego todos los lanzamientos.
const candidatos = [];
const maxLen = Math.max(marcasOrdenadas.length, dropsOrdenados.length);
for (let i = 0; i < maxLen; i++) {
  if (marcasOrdenadas[i]) candidatos.push(marcasOrdenadas[i]);
  if (dropsOrdenados[i]) candidatos.push(dropsOrdenados[i]);
}
---

{candidatos.length > 0 && (
  <div id="notif-widget" class="notif-widget" hidden>
    <button type="button" class="notif-cerrar" aria-label="Cerrar notificaciones">✕</button>

    <div class="notif-pila" id="notif-pila" role="status" aria-live="polite">
      <div class="notif-ghost notif-ghost-2"></div>
      <div class="notif-ghost notif-ghost-1"></div>
      <a class="notif-card" id="notif-card-actual" href="#">
        <div class="notif-media"><img src="" alt="" loading="lazy" /></div>
        <div class="notif-body">
          <span class="notif-tag"></span>
          <strong class="notif-title"></strong>
          <span class="notif-sub"></span>
        </div>
      </a>
    </div>

    <div class="notif-historial" id="notif-historial">
      <div class="notif-historial-head">Últimas novedades</div>
      <div class="notif-historial-lista" id="notif-historial-lista"></div>
    </div>
  </div>

  <script type="application/json" id="notif-datos" set:html={JSON.stringify(candidatos)} is:inline />

  <script is:inline>
    (function () {
      const datosEl = document.getElementById('notif-datos');
      const widget = document.getElementById('notif-widget');
      if (!datosEl || !widget) return;

      let candidatos = [];
      try {
        candidatos = JSON.parse(datosEl.textContent || '[]');
      } catch {
        return;
      }
      if (!candidatos.length) return;

      const CERRADO_KEY = 'apoloRadarNotifCerrado';
      const POS_KEY = 'apoloRadarNotifPos';
      const HIST_KEY = 'apoloRadarNotifHistorial';
      const INTERVALO_MS = 6000;
      const RETRASO_INICIAL_MS = 2500;
      const MAX_HISTORIAL = 12;

      if (sessionStorage.getItem(CERRADO_KEY) === '1') return;

      let posicion = 0;
      try {
        posicion = parseInt(sessionStorage.getItem(POS_KEY) || '0', 10) || 0;
      } catch {}

      let historialIds = [];
      try {
        historialIds = JSON.parse(sessionStorage.getItem(HIST_KEY) || '[]');
      } catch {}

      const card = document.getElementById('notif-card-actual');
      const pila = document.getElementById('notif-pila');
      const historialLista = document.getElementById('notif-historial-lista');
      const img = card.querySelector('img');
      const tag = card.querySelector('.notif-tag');
      const title = card.querySelector('.notif-title');
      const sub = card.querySelector('.notif-sub');

      function pintarTarjeta(item) {
        if (item.imagen) {
          img.src = item.imagen;
          img.alt = item.titulo;
          img.style.display = '';
        } else {
          img.style.display = 'none';
        }
        card.href = item.enlace;
        tag.textContent = item.etiqueta;
        title.textContent = item.titulo;
        sub.textContent = item.subtitulo || '';
      }

      function registrarHistorial(item) {
        historialIds = historialIds.filter((id) => id !== item.id);
        historialIds.unshift(item.id);
        historialIds = historialIds.slice(0, MAX_HISTORIAL);
        try {
          sessionStorage.setItem(HIST_KEY, JSON.stringify(historialIds));
        } catch {}
      }

      function pintarHistorial() {
        const items = historialIds
          .map((id) => candidatos.find((c) => c.id === id))
          .filter(Boolean);
        historialLista.innerHTML = '';
        items.forEach((item) => {
          const fila = document.createElement('a');
          fila.className = 'notif-hist-fila';
          fila.href = item.enlace;
          fila.innerHTML =
            '<div class="notif-hist-media">' +
            (item.imagen ? '<img src="' + item.imagen + '" alt="" loading="lazy" />' : '') +
            '</div>' +
            '<div class="notif-hist-body">' +
            '<span class="notif-hist-tag">' + item.etiqueta + '</span>' +
            '<span class="notif-hist-title">' + item.titulo + '</span>' +
            '</div>';
          historialLista.appendChild(fila);
        });
      }

      function avanzar() {
        const item = candidatos[posicion % candidatos.length];
        pintarTarjeta(item);
        registrarHistorial(item);
        pintarHistorial();

        pila.classList.remove('notif-pila-entrando');
        void pila.offsetWidth;
        pila.classList.add('notif-pila-entrando');

        posicion += 1;
        try {
          sessionStorage.setItem(POS_KEY, String(posicion));
        } catch {}
      }

      let temporizador = null;
      function iniciarRotacion() {
        detenerRotacion();
        temporizador = setInterval(avanzar, INTERVALO_MS);
      }
      function detenerRotacion() {
        if (temporizador) clearInterval(temporizador);
        temporizador = null;
      }

      widget.addEventListener('mouseenter', () => {
        widget.classList.add('notif-expandido');
        detenerRotacion();
      });
      widget.addEventListener('mouseleave', () => {
        widget.classList.remove('notif-expandido');
        iniciarRotacion();
      });

      widget.querySelector('.notif-cerrar').addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        detenerRotacion();
        widget.classList.add('notif-saliendo');
        try {
          sessionStorage.setItem(CERRADO_KEY, '1');
        } catch {}
        setTimeout(() => {
          widget.hidden = true;
        }, 300);
      });

      setTimeout(() => {
        widget.hidden = false;
        avanzar();
        requestAnimationFrame(() => widget.classList.add('notif-visible'));
        iniciarRotacion();
      }, RETRASO_INICIAL_MS);
    })();
  </script>
)}

<style>
  .notif-widget {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 999;
    width: min(320px, calc(100vw - 32px));
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .notif-widget.notif-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .notif-widget.notif-saliendo {
    opacity: 0;
    transform: translateY(24px);
  }

  .notif-cerrar {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 22px;
    height: 22px;
    border: none;
    border-radius: 50%;
    background: #111;
    color: #fff;
    font-size: 11px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .notif-pila {
    position: relative;
  }

  .notif-ghost {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    background: #1c1c1c;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .notif-ghost-1 {
    transform: translateY(-8px) scale(0.96);
    opacity: 0.7;
    z-index: 1;
  }

  .notif-ghost-2 {
    transform: translateY(-15px) scale(0.92);
    opacity: 0.4;
    z-index: 0;
  }

  .notif-card {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background: #111;
    color: #fff;
    border-radius: 14px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    text-decoration: none;
    overflow: hidden;
  }

  .notif-pila-entrando .notif-card {
    animation: notifEntra 0.4s ease;
  }

  @keyframes notifEntra {
    from {
      transform: translateY(10px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .notif-media {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 8px;
    overflow: hidden;
    background: #222;
  }

  .notif-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .notif-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .notif-tag {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #ffd23f;
  }

  .notif-title {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .notif-sub {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .notif-historial {
    display: none;
    margin-top: 8px;
    background: #111;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    max-height: 320px;
    overflow-y: auto;
  }

  .notif-widget.notif-expandido .notif-pila {
    display: none;
  }

  .notif-widget.notif-expandido .notif-historial {
    display: block;
  }

  .notif-historial-head {
    padding: 10px 12px 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.5);
  }

  /* Las filas de abajo las crea JavaScript al vuelo (cuando pasas el cursor),
     así que Astro no las "ve" al construir la página y no les aplicaría estos
     estilos si no los marcamos como :global(). */

  :global(.notif-hist-fila) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    text-decoration: none;
    color: #fff;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  :global(.notif-hist-fila:hover) {
    background: rgba(255, 255, 255, 0.06);
  }

  :global(.notif-hist-media) {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    overflow: hidden;
    background: #222;
  }

  :global(.notif-hist-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.notif-hist-body) {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  :global(.notif-hist-tag) {
    font-size: 10px;
    font-weight: 600;
    color: #ffd23f;
    text-transform: uppercase;
  }

  :global(.notif-hist-title) {
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 480px) {
    .notif-widget {
      left: 12px;
      right: 12px;
      bottom: 12px;
      width: auto;
    }
  }
</style>
