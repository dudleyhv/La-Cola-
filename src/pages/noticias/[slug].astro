---
import '../../styles/global.css';
import articulos from '../../data/articulos.json';
import marcas from '../../data/marcas.json';
import drops from '../../data/drops.json';
import NotificacionFlotante from '../../components/NotificacionFlotante.astro';

export function getStaticPaths() {
  return articulos.map((articulo) => ({
    params: { slug: articulo.slug },
    props: { articulo },
  }));
}

const { articulo } = Astro.props;
const parrafos = (articulo.body || articulo.excerpt || '').split('\n\n').filter(Boolean);
const esLanzamiento = articulo.type === 'lanzamiento';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{articulo.title} — Apolo Radar</title>
  <meta name="description" content={articulo.excerpt} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href="/">Apolo <span>Radar</span></a>
    <nav id="nav-principal">
      <a href="/noticias" class="active">Noticias</a>
      <a href="/marcas-a-seguir">Marcas a Seguir</a>
      <a href="/lanzamientos">Lanzamientos</a>
    </nav>
    <div class="header-right">
      <a class="btn-subscribe" href="/#newsletter">Suscríbete</a>
      <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-principal">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('menu-toggle');
    const nav = document.getElementById('nav-principal');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () {
      const abierto = nav.classList.toggle('nav-abierto');
      btn.classList.toggle('abierto', abierto);
      btn.setAttribute('aria-expanded', abierto ? 'true' : 'false');
    });
  })();
</script>

<main class="wrap article-main">

  <a class="article-back" href="/noticias">&larr; Volver a todas las noticias</a>

  <span class="article-topic">{articulo.topic}</span>
  <h1 class="article-title">{articulo.title}</h1>

  {esLanzamiento && (
    <div class="release-panel">
      <div class="release-block">
        <p class="release-heading">Detalles del lanzamiento</p>
        <div class="release-row">
          <span class="release-label">Producto</span>
          <span class="release-value">{articulo.title}</span>
        </div>
        <div class="release-row">
          <span class="release-label">Fecha de lanzamiento</span>
          <span class="release-value num">{articulo.day ? `${articulo.day} ${articulo.date}` : articulo.date}</span>
        </div>
        {articulo.sku && (
          <div class="release-row">
            <span class="release-label">SKU</span>
            <span class="release-value num">{articulo.sku}</span>
          </div>
        )}
        {articulo.colorway && (
          <div class="release-row">
            <span class="release-label">Colorway</span>
            <span class="release-value">{articulo.colorway}</span>
          </div>
        )}
        <div class="release-row">
          <span class="release-label">Precio</span>
          <span class="release-value num">{articulo.price}</span>
        </div>
      </div>

      {articulo.compra?.length > 0 && (
        <div class="release-block release-buy-block">
          <p class="release-heading">Dónde comprarlo</p>
          <div class="release-buy-list">
            {articulo.compra.map((c) => (
              <a class="release-buy-btn" href={c.url} target="_blank" rel="noopener">{c.tienda}</a>
            ))}
          </div>
        </div>
      )}
    </div>
  )}

  <div class="article-media">
    {articulo.image
      ? <img src={articulo.image} alt={articulo.title} loading="lazy" />
      : <span class="media-fallback">Sin imagen</span>}
  </div>

  <div class="article-body">
    {parrafos.map((p) => <p>{p}</p>)}
  </div>

  {articulo.sourceUrl && (
    <p class="article-source">
      Noticia original en <a href={articulo.sourceUrl} target="_blank" rel="noopener">{articulo.sourceName || 'la fuente original'}</a>.
    </p>
  )}

  <div class="comments-block" id="comentarios">
    <h2 class="comments-title">Comentarios</h2>
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo="dudleyhv/La-Cola-"
      data-repo-id="R_kgDOUaOtBQ"
      data-category="Announcements"
      data-category-id="DIC_kwDOUaOtBc4DFwCz"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="light"
      data-lang="es"
      crossorigin="anonymous"
      async></script>
  </div>

</main>

<NotificacionFlotante marcas={marcas} drops={drops} />

<footer>
  <div class="wrap foot-inner">
    <span>© 2026 Apolo Radar</span>
    <span>Aviso de afiliados · Contacto · Envía un drop</span>
  </div>
</footer>

</body>
</html>
