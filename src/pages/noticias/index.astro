---
import '../../styles/global.css';
import articulos from '../../data/articulos.json';
import marcas from '../../data/marcas.json';
import drops from '../../data/drops.json';
import NotificacionFlotante from '../../components/NotificacionFlotante.astro';

// Igual que en el resto de la web, no listamos artículos sin foto todavía.
const ordenados = articulos
  .filter((a) => a.image)
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Todas las noticias — Apolo Radar</title>
  <meta name="description" content="Todas las noticias y lanzamientos de sneakers y streetwear publicados en Apolo Radar." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href="/">Apolo <span>Radar</span></a>
    <nav id="nav-principal">
      <a href="/noticias" class="active">Noticias</a>
      <a href="/marcas-a-seguir">Marcas a Seguir</a>
      <a href="/lanzamientos">Lanzamientos</a>
    </nav>
    <div class="header-right">
      <a class="btn-subscribe" href="/#newsletter">Suscríbete</a>
      <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-principal">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('menu-toggle');
    const nav = document.getElementById('nav-principal');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () {
      const abierto = nav.classList.toggle('nav-abierto');
      btn.classList.toggle('abierto', abierto);
      btn.setAttribute('aria-expanded', abierto ? 'true' : 'false');
    });
  })();
</script>

<main class="wrap">

  <section class="block">
    <div class="block-head">
      <h2>Todas las noticias</h2>
    </div>

    <div class="marcas-grid">
      {ordenados.map((a) => (
        <a class="news-card" href={`/noticias/${a.slug}`}>
          <div class="card-media">
            {a.image
              ? <img src={a.image} alt={a.title} loading="lazy" />
              : <span class="media-fallback">Sin imagen</span>}
          </div>
          <span class="topic">{a.topic}</span>
          <h4>{a.title}</h4>
        </a>
      ))}
      {ordenados.length === 0 && <p>Todavía no hay noticias publicadas.</p>}
    </div>
  </section>

</main>

<NotificacionFlotante marcas={marcas} drops={drops} />

<footer>
  <div class="wrap foot-inner">
    <span>© 2026 Apolo Radar</span>
    <span>Aviso de afiliados · Contacto · Envía un drop</span>
  </div>
</footer>

</body>
</html>
