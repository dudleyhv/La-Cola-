---
import '../styles/global.css';
import productos from '../data/inditex.json';

const ordenados = [...productos].sort(
  (a, b) => new Date(b.fechaAlta).getTime() - new Date(a.fechaAlta).getTime()
);
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tendencias Inditex — La Cola</title>
  <meta name="description" content="Prendas de Zara, Pull&Bear, Bershka y Stradivarius relacionadas con las tendencias de streetwear del momento." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href="/">La <span>Cola</span></a>
    <nav>
      <a href="/#lanzamientos">Lanzamientos</a>
      <a href="/#noticias">Noticias</a>
      <a href="/marcas-a-seguir">Marcas a Seguir</a>
      <a href="/tendencias-inditex" class="active">Tendencias Inditex</a>
    </nav>
    <a class="btn-subscribe" href="/#newsletter">Suscríbete</a>
  </div>
</header>

<main class="wrap">

  <section class="block">
    <div class="block-head">
      <h2>Tendencias Inditex</h2>
    </div>
    <p class="marcas-intro">
      Prendas de Zara, Pull&amp;Bear, Bershka y Stradivarius que encajan con las tendencias
      de streetwear del momento.
    </p>

    <div class="marcas-grid">
      {ordenados.map((p) => (
        <article class="marca-card">
          <div class="marca-media">
            {p.imagen
              ? <img src={p.imagen} alt={p.titulo} loading="lazy" />
              : <span class="media-fallback">Sin imagen</span>}
          </div>
          <span class="topic">{p.marca}</span>
          <h3>{p.titulo}</h3>
          {p.palabrasClave?.length > 0 && (
            <div class="marca-links">
              {p.palabrasClave.map((k) => <span class="tag-chip">{k}</span>)}
            </div>
          )}
          <a class="see-all" href={p.url} target="_blank" rel="noopener">Ver producto</a>
        </article>
      ))}
      {ordenados.length === 0 && <p>Todavía no hay productos destacados. ¡Vuelve pronto!</p>}
    </div>
  </section>

</main>

<footer>
  <div class="wrap foot-inner">
    <span>© 2026 La Cola</span>
    <span>Aviso de afiliados · Contacto · Envía un drop</span>
  </div>
</footer>

</body>
</html>
