---
import '../styles/global.css';
import marcas from '../data/marcas.json';

const ordenadas = [...marcas].sort(
  (a, b) => new Date(b.firstFeatured).getTime() - new Date(a.firstFeatured).getTime()
);
const destacadas = ordenadas.slice(0, 3);
const resto = ordenadas.slice(3);
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Marcas a Seguir — Apolo Radar</title>
  <meta name="description" content="Marcas de streetwear emergentes y poco conocidas, con seguimiento de su evolución." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href="/">Apolo <span>Radar</span></a>
    <nav>
      <a href="/#lanzamientos">Lanzamientos</a>
      <a href="/#noticias">Noticias</a>
      <a href="/marcas-a-seguir" class="active">Marcas a Seguir</a>
    </nav>
    <a class="btn-subscribe" href="/#newsletter">Suscríbete</a>
  </div>
</header>

<main class="wrap">

  <section class="block">
    <div class="block-head">
      <h2>Marcas a Seguir</h2>
    </div>
    <p class="marcas-intro">
      Cada semana descubrimos marcas de streetwear pequeñas o poco conocidas que merece la pena seguir,
      y vamos contando cómo evolucionan en el tiempo.
    </p>

    {destacadas.length > 0 && (
      <>
        <span class="tag-pill marcas-semana-tag">Esta semana</span>
        <div class="marcas-featured">
          {destacadas.map((m) => (
            <article class="marca-featured-card">
              <a href={`/marcas/${m.slug}`} class="marca-featured-media">
                {m.image
                  ? <img src={m.image} alt={m.name} loading="lazy" />
                  : <span class="media-fallback">Sin imagen</span>}
              </a>
              <div class="marca-featured-body">
                <h3><a href={`/marcas/${m.slug}`}>{m.name}</a></h3>
                <p>{m.description}</p>
                {(m.instagram || m.shopUrl) && (
                  <div class="marca-links">
                    {m.instagram && <a href={m.instagram} target="_blank" rel="noopener">Instagram</a>}
                    {m.shopUrl && <a href={m.shopUrl} target="_blank" rel="noopener">Tienda</a>}
                  </div>
                )}
                <a class="see-all" href={`/marcas/${m.slug}`}>Ver ficha completa</a>
              </div>
            </article>
          ))}
        </div>
      </>
    )}

    {resto.length > 0 && (
      <>
        <div class="block-head">
          <h2>Más marcas descubiertas</h2>
        </div>
        <div class="marcas-grid">
          {resto.map((m) => (
            <article class="marca-card">
              <a href={`/marcas/${m.slug}`} class="marca-media">
                {m.image
                  ? <img src={m.image} alt={m.name} loading="lazy" />
                  : <span class="media-fallback">Sin imagen</span>}
              </a>
              <h3><a href={`/marcas/${m.slug}`}>{m.name}</a></h3>
              <p>{m.description}</p>
              {m.updates?.length > 0 && (
                <ul class="marca-updates">
                  {m.updates.map((u) => (
                    <li><span class="num">{u.date}</span> — {u.note}</li>
                  ))}
                </ul>
              )}
              {(m.instagram || m.shopUrl) && (
                <div class="marca-links">
                  {m.instagram && <a href={m.instagram} target="_blank" rel="noopener">Instagram</a>}
                  {m.shopUrl && <a href={m.shopUrl} target="_blank" rel="noopener">Tienda</a>}
                </div>
              )}
              <a class="see-all" href={`/marcas/${m.slug}`}>Ver ficha completa</a>
            </article>
          ))}
        </div>
      </>
    )}

    {ordenadas.length === 0 && <p>Todavía no hay marcas destacadas. ¡Vuelve pronto!</p>}
  </section>

</main>

<footer>
  <div class="wrap foot-inner">
    <span>© 2026 Apolo Radar</span>
    <span>Aviso de afiliados · Contacto · Envía un drop</span>
  </div>
</footer>

</body>
</html>
