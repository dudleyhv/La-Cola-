---
import '../styles/global.css';
import hero from '../data/hero.json';
import drops from '../data/drops.json';
import news from '../data/news.json';
import marcas from '../data/marcas.json';
import NotificacionFlotante from '../components/NotificacionFlotante.astro';

const marcasDestacadas = [...marcas]
  .sort((a, b) => new Date(b.firstFeatured).getTime() - new Date(a.firstFeatured).getTime())
  .slice(0, 3);
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Apolo Radar — Sneakers y streetwear al día</title>
  <meta name="description" content="Lanzamientos, restocks y noticias de sneakers y streetwear, actualizado cada día." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href="/">Apolo <span>Radar</span></a>
    <nav>
      <a href="#lanzamientos">Lanzamientos</a>
      <a href="#noticias">Noticias</a>
      <a href="/marcas-a-seguir">Marcas a Seguir</a>
    </nav>
    <a class="btn-subscribe" href="#newsletter">Suscríbete</a>
  </div>
</header>

<main class="wrap">

  <section class="hero">
    <div class="ticket">
      <div class="ticket-eyebrow-row">
        <span class="tag-pill">{hero.tag}</span>
        {hero.dateLabel && <span class="countdown">{hero.dateLabel}</span>}
      </div>
      <h1>{hero.title}</h1>
      <p class="meta">{hero.description}</p>
      <div class="price-row">
        <span class="store">{hero.store}</span>
      </div>
      <a class="cta" href={hero.slug ? `/noticias/${hero.slug}` : hero.ctaUrl}>{hero.ctaText}</a>
    </div>
    <div class="hero-art">
      {hero.image
        ? <img src={hero.image} alt={hero.title} loading="lazy" />
        : <span class="media-fallback media-fallback--dark">Sin imagen</span>}
    </div>
  </section>

  <section class="block" id="lanzamientos">
    <div class="block-head">
      <h2>Calendario de lanzamientos</h2>
      <a class="see-all" href="/noticias">Ver todos</a>
    </div>
    <div class="cal-row">
      {drops.map((d) => (
        <a class="cal-card" href={d.slug ? `/noticias/${d.slug}` : d.url}>
          <div class="cal-media">
            {d.image
              ? <img src={d.image} alt={d.model} loading="lazy" />
              : <span class="media-fallback">Sin imagen</span>}
          </div>
          <span class="cal-day">{d.day}</span>
          <span class="cal-date num">{d.date}</span>
          <span class="cal-model">{d.model}</span>
          {d.stores?.length > 1 && <span class="cal-stores">{d.stores.join(', ')}</span>}
          <div class="cal-foot"><span>{d.time}</span><span>{d.price}</span></div>
        </a>
      ))}
    </div>
  </section>

  <section class="block" id="noticias">
    <div class="block-head">
      <h2>Noticias</h2>
      <a class="see-all" href="/noticias">Ver todas</a>
    </div>
    <div class="news-grid">
      <a class="news-feature" href={news.feature.slug ? `/noticias/${news.feature.slug}` : news.feature.url}>
        <div class="feature-media">
          {news.feature.image
            ? <img src={news.feature.image} alt={news.feature.title} loading="lazy" />
            : <span class="media-fallback">Sin imagen</span>}
        </div>
        <span class="topic">{news.feature.topic}</span>
        <h3>{news.feature.title}</h3>
        <p>{news.feature.excerpt}</p>
      </a>
      <div class="news-side">
        {news.side.map((n) => (
          <a class="news-card" href={n.slug ? `/noticias/${n.slug}` : n.url}>
            <div class="card-media">
              {n.image
                ? <img src={n.image} alt={n.title} loading="lazy" />
                : <span class="media-fallback">Sin imagen</span>}
            </div>
            <span class="topic">{n.topic}</span>
            <h4>{n.title}</h4>
          </a>
        ))}
      </div>
    </div>
  </section>

  {marcasDestacadas.length > 0 && (
    <section class="block" id="marcas-a-seguir">
      <div class="block-head">
        <h2>Marcas a Seguir</h2>
        <a class="see-all" href="/marcas-a-seguir">Ver todas</a>
      </div>
      <p class="marcas-intro">Esta semana: marcas de streetwear pequeñas o poco conocidas que merece la pena descubrir.</p>
      <div class="marcas-featured">
        {marcasDestacadas.map((m) => (
          <article class="marca-featured-card">
            <a href={`/marcas/${m.slug}`} class="marca-featured-media">
              {m.image
                ? <img src={m.image} alt={m.name} loading="lazy" />
                : <span class="media-fallback">Sin imagen</span>}
            </a>
            <div class="marca-featured-body">
              <h3><a href={`/marcas/${m.slug}`}>{m.name}</a></h3>
              <p>{m.description}</p>
              <a class="see-all" href={`/marcas/${m.slug}`}>Ver ficha completa</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="block newsletter" id="newsletter">
    <div>
      <h2>No te pierdas ningún drop</h2>
      <p>Un aviso al día con los lanzamientos, restocks y noticias que de verdad importan. Sin spam.</p>
    </div>
    <form
      class="sub-form"
      action="https://buttondown.com/api/emails/embed-subscribe/dudleyhv"
      method="post"
      target="_blank"
    >
      <input type="email" name="email" placeholder="tu@email.com" aria-label="Correo electrónico" required />
      <input type="hidden" value="1" name="embed" />
      <button type="submit">Apuntarme</button>
    </form>
  </section>

</main>

<NotificacionFlotante marcas={marcas} drops={drops} />

<footer>
  <div class="wrap foot-inner">
    <span>© 2026 Apolo Radar</span>
    <span>Aviso de afiliados · Contacto · Envía un drop</span>
  </div>
</footer>

</body>
</html>
