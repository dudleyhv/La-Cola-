---
import '../styles/global.css';
import hero from '../data/hero.json';
import drops from '../data/drops.json';
import news from '../data/news.json';
import marcas from '../data/marcas.json';
import articulos from '../data/articulos.json';
import NotificacionFlotante from '../components/NotificacionFlotante.astro';
import Topico from '../components/Topico.astro';

// news.json no guarda fecha ni fuente, pero el artículo ya está también en la
// hemeroteca (articulos.json) con esos datos: los recuperamos por slug para
// poder mostrar "Fuente · fecha" bajo la noticia destacada y las secundarias.
function metaDe(slug) {
  const a = articulos.find((x) => x.slug === slug);
  if (!a) return '';
  const fecha = new Date(a.publishedAt + 'T00:00:00').toLocaleDateString('es-ES', {
    day: 'numeric',
    month: 'short',
  });
  return a.sourceName ? `${a.sourceName} · ${fecha}` : fecha;
}

// La tarjeta destacada de "Noticias" suele tener bastante menos texto que las
// 3 tarjetas de al lado, y eso dejaba un hueco vacío debajo. En vez de forzar
// la altura con CSS, lo aprovechamos con contenido real: unos titulares más
// que no caben en el hueco de 4 noticias de arriba.
const slugsEnPortada = new Set([news.feature.slug, ...news.side.map((n) => n.slug)]);
const masNoticias = [...articulos]
  .filter((a) => a.type === 'noticia' && !slugsEnPortada.has(a.slug))
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 4);

const marcasDestacadas = [...marcas]
  .sort((a, b) => new Date(b.firstFeatured).getTime() - new Date(a.firstFeatured).getTime())
  .slice(0, 3);

// Solo mostramos lanzamientos que ya tienen foto: uno sin imagen queda
// mal en el escaparate principal de la web y transmite que está incompleto.
const dropsConFoto = drops.filter((d) => d.image);

// Carrusel de portada: usamos hasta 5 lanzamientos recientes como diapositivas.
// Si todavía no hay ninguno, usamos hero.json como única diapositiva de reserva.
const slidesDeDrops = dropsConFoto.slice(0, 5).map((d) => ({
  tag: 'Lanzamiento destacado',
  dateLabel: d.day && d.date !== 'Próximamente' ? `${d.day} ${d.date}` : '',
  title: d.model,
  description: `Hora de apertura: ${d.time} · Precio: ${d.price}`,
  store: d.stores?.length > 0 ? d.stores.join(', ') : 'tienda por confirmar',
  image: d.image,
  ctaText: 'Leer la noticia completa',
  href: d.slug ? `/noticias/${d.slug}` : d.url,
}));

const heroSlides = slidesDeDrops.length > 0
  ? slidesDeDrops
  : [{
      tag: hero.tag,
      dateLabel: hero.dateLabel,
      title: hero.title,
      description: hero.description,
      store: hero.store,
      image: hero.image,
      ctaText: hero.ctaText,
      href: hero.slug ? `/noticias/${hero.slug}` : hero.ctaUrl,
    }];

// Fila de lanzamientos destacados justo debajo del vídeo de portada (como en
// New Wave Magazine): los siguientes lanzamientos relevantes, sin repetir el
// que ya se muestra en el panel de texto del vídeo.
const destacadosRow = dropsConFoto.length > 1
  ? dropsConFoto.slice(1, 6)
  : [];
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Apolo Radar — Sneakers y streetwear al día</title>
  <meta name="description" content="Lanzamientos, restocks y noticias de sneakers y streetwear, actualizado cada día." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href="/">Apolo <span>Radar</span></a>
    <nav id="nav-principal">
      <a href="/noticias">Noticias</a>
      <a href="/marcas-a-seguir">Marcas a Seguir</a>
      <a href="/lanzamientos">Lanzamientos</a>
    </nav>
    <div class="header-right">
      <a class="btn-subscribe" href="#newsletter">Suscríbete</a>
      <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-principal">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('menu-toggle');
    const nav = document.getElementById('nav-principal');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () {
      const abierto = nav.classList.toggle('nav-abierto');
      btn.classList.toggle('abierto', abierto);
      btn.setAttribute('aria-expanded', abierto ? 'true' : 'false');
    });
  })();
</script>

<section class="hero-full">
  <video
    class="hero-full-video"
    autoplay
    muted
    loop
    playsinline
    poster={heroSlides[0].image || undefined}
  >
    <source src="/portada/video-semana.mp4" type="video/mp4" />
  </video>
  <div class="hero-full-overlay">
    <span class="hero-full-wordmark">APOLO <span>RADAR</span></span>
    <span class="hero-full-scroll">Desliza para ver más ↓</span>
  </div>
</section>

<main class="wrap">

  {destacadosRow.length > 0 && (
    <section class="destacados-row">
      {destacadosRow.map((d) => (
        <a class="destacado-card" href={d.slug ? `/noticias/${d.slug}` : d.url}>
          <div class="destacado-media">
            {d.image
              ? <img src={d.image} alt={d.model} loading="lazy" />
              : <span class="media-fallback">Sin imagen</span>}
          </div>
          <Topico texto="Lanzamiento" />
          <h4 class="destacado-title">{d.model}</h4>
          <p class="destacado-meta">
            {d.day && d.date !== 'Próximamente' ? `${d.day} ${d.date}` : 'Próximamente'} · {d.price}
          </p>
        </a>
      ))}
    </section>
  )}

  <section class="block" id="noticias">
    <div class="block-head">
      <h2>Noticias</h2>
      <a class="see-all" href="/noticias">Ver todas</a>
    </div>
    <div class="news-grid">
      <div class="news-feature">
        <a class="news-feature-link" href={news.feature.slug ? `/noticias/${news.feature.slug}` : news.feature.url}>
          <div class="feature-media">
            {news.feature.image
              ? <img src={news.feature.image} alt={news.feature.title} loading="lazy" />
              : <span class="media-fallback">Sin imagen</span>}
          </div>
          <Topico texto={news.feature.topic} />
          <h3>{news.feature.title}</h3>
          <p>{news.feature.excerpt}</p>
          {metaDe(news.feature.slug) && <span class="news-meta">{metaDe(news.feature.slug)}</span>}
        </a>

        {masNoticias.length > 0 && (
          <div class="news-feature-more">
            <span class="news-feature-more-heading">Más noticias</span>
            <ul class="news-feature-more-list">
              {masNoticias.map((a) => (
                <li>
                  <a href={`/noticias/${a.slug}`}>
                    <Topico texto={a.topic} />
                    <span class="news-feature-more-title">{a.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
      <div class="news-side">
        {news.side.map((n) => (
          <a class="news-card" href={n.slug ? `/noticias/${n.slug}` : n.url}>
            <div class="card-media">
              {n.image
                ? <img src={n.image} alt={n.title} loading="lazy" />
                : <span class="media-fallback">Sin imagen</span>}
            </div>
            <Topico texto={n.topic} />
            <h4>{n.title}</h4>
            {metaDe(n.slug) && <span class="news-meta">{metaDe(n.slug)}</span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  {marcasDestacadas.length > 0 && (
    <section class="block" id="marcas-a-seguir">
      <div class="block-head">
        <h2>Marcas a Seguir</h2>
        <a class="see-all" href="/marcas-a-seguir">Ver todas</a>
      </div>
      <p class="marcas-intro">Esta semana: marcas de streetwear pequeñas o poco conocidas que merece la pena descubrir.</p>
      <div class="marcas-featured">
        {marcasDestacadas.map((m) => (
          <article class="marca-featured-card">
            <a href={`/marcas/${m.slug}`} class="marca-featured-media">
              {m.image
                ? <img src={m.image} alt={m.name} loading="lazy" />
                : <span class="media-fallback">Sin imagen</span>}
            </a>
            <div class="marca-featured-body">
              <h3><a href={`/marcas/${m.slug}`}>{m.name}</a></h3>
              <p>{m.description}</p>
              <a class="see-all" href={`/marcas/${m.slug}`}>Ver ficha completa</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="block" id="lanzamientos">
    <div class="block-head">
      <h2>Lanzamientos que quizás te interesen</h2>
      <a class="see-all" href="/lanzamientos">Ver todos</a>
    </div>
    <div class="cal-row">
      {dropsConFoto.map((d, i) => (
        <a class="cal-card" href={d.slug ? `/noticias/${d.slug}` : d.url}>
          <div class="cal-media">
            {d.image
              ? <img src={d.image} alt={d.model} loading="lazy" />
              : <span class="media-fallback">Sin imagen</span>}
            <div class="cal-date-badge">
              <span class="cal-badge-day">{d.day || '—'}</span>
              <span class="cal-badge-date num">{d.date}</span>
            </div>
            {i === 0 && <span class="cal-proximo">Próximo</span>}
          </div>
          <div class="cal-body">
            <h3 class="cal-model">{d.model}</h3>
            {d.stores?.length > 0 && (
              <div class="cal-stores-row">
                {d.stores.slice(0, 3).map((s) => <span class="cal-store-pill">{s}</span>)}
              </div>
            )}
            <div class="cal-foot"><span>{d.time}</span><span class="num">{d.price}</span></div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="block newsletter" id="newsletter">
    <div>
      <h2>No te pierdas ningún drop</h2>
      <p>Un aviso al día con los lanzamientos, restocks y noticias que de verdad importan. Sin spam.</p>
    </div>
    <form
      class="sub-form"
      action="https://buttondown.com/api/emails/embed-subscribe/dudleyhv"
      method="post"
      target="_blank"
    >
      <input type="email" name="email" placeholder="tu@email.com" aria-label="Correo electrónico" required />
      <input type="hidden" value="1" name="embed" />
      <button type="submit">Apuntarme</button>
    </form>
  </section>

</main>

<section class="about-us">
  <div class="wrap about-us-inner">
    <span class="about-us-eyebrow">Sobre nosotros</span>
    <h2 class="about-us-statement">Menos ruido, más descubrimiento.</h2>
    <p class="about-us-text">
      Apolo Radar nace para dar espacio a los lanzamientos que de verdad importan, no solo a los de
      siempre. Cada semana filtramos entre cientos de restocks y colaboraciones para quedarnos con lo
      relevante, en vez de repetir lo mismo que ya ves en todas partes.
    </p>
    <p class="about-us-text">
      Por eso dedicamos una sección entera a marcas de streetwear pequeñas o poco conocidas: de esas
      que, con el tiempo, acaban siguiendo todos. Queremos que quien nos lea cada semana no solo esté
      al día del próximo drop de las marcas grandes, sino que vaya descubriendo, poco a poco, nombres
      que quizás no conocía todavía.
    </p>
  </div>
</section>

<NotificacionFlotante marcas={marcas} drops={drops} />

<footer>
  <div class="wrap foot-inner">
    <span>© 2026 Apolo Radar</span>
    <span>Aviso de afiliados · Contacto · Envía un drop</span>
  </div>
</footer>

</body>
</html>
